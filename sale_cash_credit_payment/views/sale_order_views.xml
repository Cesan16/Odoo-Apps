<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_cash_credit_payment" model="ir.ui.view">
        <field name="name">sale.order.form.cash.credit.payment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm'][1]" position="attributes">
                <attribute name="name">action_open_confirmation_warning</attribute>
                <attribute name="type">object</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <separator string="Sales Payment Confirmation"/>
                <div class="o_form_label fw-bold">
                    Review the payment type carefully. Cash sales require a journal and will
                    register payment automatically, while credit sales will only create and post
                    the invoice.
                </div>
                <field name="sale_payment_type" placeholder="Select sales type"/>
                <field name="cash_payment_journal_id" invisible="sale_payment_type != 'cash'" required="sale_payment_type == 'cash'"/>
            </xpath>
        </field>
    </record>
</odoo>
